{
  "manifest_version": 3,
  "name": "Keep Me in Suspense!",
  "version": "0.1.0",
  "description": "Automatically suspends inactive tabs to save memory and CPU.",

  "permissions": [
    "tabs",
    "tabGroups",
    "alarms",
    "storage",
    "sidePanel",
    "scripting",
    "contextMenus",
    "debugger"
  ],
  "host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "code/scripts/background.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "code/interface/sidepanel/index.html"
  },

  "action": {
    "default_title": "Keep Me in Suspense!",
    "default_popup": "code/interface/popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },

  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
